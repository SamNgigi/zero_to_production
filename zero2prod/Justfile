set dotenv-load := true


default:
  cargo clippy --all-targets -- -D warnings

todos:
  cargo clippy --all-targets -- -W clippy::todos

itest target="*" fn="":
  cargo test --test '{{target}}' -- {{fn}}

gdiff:
  git diff -- . ':(exclude)Cargo.lock'

# NOTE: Docker commands
doc-dbshell db_container_name="newsletter_axum_postgres" db_name="newsletter":
  docker exec -it {{db_container_name}} psql -U postgres -d {{db_name}}

# NOTE: Fly.io commands
fly-ssh:
  flyctl ssh console

# TODO: fly-app-scale2zero:

fly-web-start:
  flyctl machine start -a $REMOTE_APP_NAME

fly-web-suspend:
  flyctl machine suspend -a $REMOTE_APP_NAME


fly-db-start:
  flyctl machine start -a $REMOTE_DB_NAME

fly-db-suspend:
  flyctl machine suspend -a $REMOTE_DB_NAME

fly-db-proxy:
  flyctl proxy 15432:5432 -a $REMOTE_DB_NAME

fly-psql:
  psql $REMOTE_PROXY_DB_URL

fly-migrate:
  DATABASE_URL=$REMOTE_PROXY_DB_URL sqlx migrate run

